#Data Loading
#  1. Import the required Python libraries
import pandas as pd
import numpy as np

# 2. Load the IPL dataset using Pandas
df = pd.read_csv("IPL_Cleaned.csv")

# 3. Display the first five records
print("First 5 Records:")
print(df.head())

# 4. Display the last five records
print("\nLast 5 Records:")
print(df.tail())

# 5. Check the dataset shape
print("\nDataset Shape:")
print(df.shape)

# 6. Display all column names
print("\nColumn Names:")
print(df.columns.tolist())

# 7. Identify numerical and categorical columns
numerical_cols = df.select_dtypes(include=['int64', 'float64']).columns.tolist()
categorical_cols = df.select_dtypes(include=['object']).columns.tolist()

print("\nNumerical Columns:")
print(numerical_cols)

print("\nCategorical Columns:")
print(categorical_cols)
